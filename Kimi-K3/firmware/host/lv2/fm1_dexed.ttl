@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix midi: <http://lv2plug.in/ns/ext/midi#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

<https://github.com/fm1-re/fm1-dexed-lv2>
    a lv2:Plugin, lv2:InstrumentPlugin ;
    lv2:project <https://github.com/fm1-re> ;
    lv2:name "FM-1 Dexed Synth" ;
    lv2:symbol "fm1_dexed" ;
    lv2:port [
        a lv2:InputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        lv2:index 0 ;
        lv2:name "MIDI In" ;
        lv2:symbol "midi_in"
    ] ;
    lv2:port [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 1 ;
        lv2:name "Audio Out" ;
        lv2:symbol "audio_out"
    ] ;
    lv2:port [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 2 ;
        lv2:name "Patch" ;
        lv2:symbol "patch" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 3 ;
        lv2:portProperty lv2:integer
    ] ;
    rdfs:comment "FM-1 custom Dexed/msfa 6-op FM synth (E.PIANO/BASS/BRASS/LEAD), reverse-engineered from the M-Vave FM-1." .
